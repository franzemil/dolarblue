# Entorno del notebook analisis_gaceta_fx.ipynb — plantilla versionable.
# Copiar a .env y ajustar las rutas al clon local:
#     cp .env.example .env
# No incluir secretos: el notebook solo lee CSV locales.

# --- Intérprete / venv -------------------------------------------------------
# Venv del proyecto (normalmente 01_intro/.venv)
VENV_PATH=../../.venv
PYTHON_BIN=../../.venv/bin/python
JUPYTER_KERNEL=maestria-01-intro
KERNELSPEC_PATH=~/Library/Jupyter/kernels/maestria-01-intro/kernel.json

# --- Rutas del proyecto ------------------------------------------------------
# Relativas a este archivo; el notebook las resuelve contra su directorio.
PROJECT_ROOT=..
MODELADO_DIR=.
DATA_DIR=../data
DATA_C_DIR=../data_c
OUTPUTS_DIR=./outputs

# --- Parámetros del notebook -------------------------------------------------
N_TEST=7
EVENT_HORA_REF_UTC=12
EVENT_VENTANA_H=5

# --- Reproducibilidad --------------------------------------------------------
RANDOM_STATE=42
